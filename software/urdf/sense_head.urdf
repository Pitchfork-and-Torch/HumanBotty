<?xml version="1.0"?>
<robot name="humanbotty_sense_head">
  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
    </visual>
  </link>
  <link name="pan_link">
    <visual>
      <geometry><cylinder radius="0.03" length="0.03"/></geometry>
    </visual>
  </link>
  <link name="tilt_link">
    <visual>
      <geometry><box size="0.12 0.08 0.1"/></geometry>
    </visual>
  </link>
  <joint name="pan" type="revolute">
    <parent link="base_link"/>
    <child link="pan_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.2" upper="1.2" effort="4" velocity="0.8"/>
  </joint>
  <joint name="tilt" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.7" effort="4" velocity="0.8"/>
  </joint>
</robot>
